{
  "declared_environment": {
    "device": "cpu-wasm",
    "dtype": "float32",
    "inference_threads": 1,
    "solver_parallelism": 1
  },
  "programs": {
    "sat": {
      "label": "Browser sat: fresh Worker, cold WASM/models; Chrome ready excluded",
      "mode": "resident",
      "cwd": "../..",
